# Copy to .env (gitignored). Only the key for the backend you use is needed.
# Without any key Jarvis still works with local commands (time, date, status, …).

# llm.backend: openai_compat, provider: gemini (free tier) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Other openai_compat providers
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# GITHUB_TOKEN=

# llm.backend: api (Claude, billed per token)
# ANTHROPIC_API_KEY=

# Overrides the data directory (default: ~/Library/Application Support/Jarvis)
# JARVIS_DATA_DIR=
